# Frontend Environment Variables
# Copy this file to .env and fill in your values

# GitHub API Configuration for Auto-Save Feature
# Your GitHub username (e.g., "emmanuelikinya")
VITE_GITHUB_OWNER=your-github-username

# Your repository name (e.g., "Orodho_family_tree")
VITE_GITHUB_REPO=your-repo-name

# Your GitHub Personal Access Token (classic)
# Create one at: https://github.com/settings/tokens
# Required permissions: repo (Full control of private repositories)
VITE_GITHUB_TOKEN=your-github-token-here
